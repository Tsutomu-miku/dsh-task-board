{
  "name": "dsh-task-board",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i src/styles.css -o dist/styles.css --minify && esbuild src/main.tsx --bundle --format=esm --platform=browser --target=es2020 --jsx=automatic --minify --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "type": "module",
  "description": "DSH 工作状态看板，支持原生 DSH 会话和 Codex CLI",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "index.mjs",
    "board.mjs",
    "native-dsh.mjs",
    "runner.mjs",
    "codex-worker.mjs",
    "client.js",
    "cordis.patch.yml",
    "index.html",
    "dist/",
    "SHADCN-LICENSE.md"
  ]
}
